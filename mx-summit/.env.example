# Copy this file to mx-summit/.env and fill in your own values.
# .env is gitignored. Never commit real credentials.

# csv = read the sample export in mx-summit/data (Session 1, default)
# api = read your live Property Meld account (Session 2)
PM_MODE=csv

# Property Meld API v2 credentials (Session 2 only).
# Ask your Property Meld account manager for API access; they issue these.
PM_CLIENT_ID=
PM_CLIENT_SECRET=
PM_TENANT_ID=

# Only change this if your Property Meld API docs give a different token URL.
# PM_TOKEN_URL=https://api.propertymeld.com/api/v2/oauth/token/
